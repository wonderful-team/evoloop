  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:offline": "EXPO_NO_NETWORK=1 expo start --offline",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
