# EvoLoop Mobile 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==========================================
# 应用配置
# ==========================================
# 应用名称
APP_NAME=EvoLoop
# 是否开启调试模式
DEBUG_MODE=true
# 日志级别: debug | info | warn | error
LOG_LEVEL=debug

# ==========================================
# API / Gateway 配置
# ==========================================
# 后端 API 基础地址（HTTP）
EVOCLOUD_BASE_URL=https://your-domain.com
# Gateway WebSocket 地址（WSS）
EVOCLOUD_BASE_WS_URL=wss://your-domain.com/gateway/ws
# 微信 Universal Link（iOS 微信 SDK 注册必需）
# 说明：微信通过此 HTTPS URL 验证应用身份，防止恶意 App 冒用 AppID。
#       必须在微信开放平台（https://open.weixin.qq.com）注册应用时配置相同的地址。
# 要求：必须是有效的 HTTPS URL，且服务器需正确响应微信的验证请求。
# 示例：https://your-domain.com/universal-link/
EVOCLOUD_UNIVERSAL_LINK_URL=https://your-domain.com/universal-link

# ==========================================
# 阿里云 NLS（实时语音识别）配置
# ==========================================
# NLS WebSocket 网关地址（默认阿里云上海节点）
NLS_WS_URL=wss://nls-gateway.aliyuncs.com/ws/v1
# NLS AppKey（从阿里云控制台获取）
# 开通地址: https://www.aliyun.com/product/nls
NLS_APP_KEY=your_nls_app_key_here
# 【可选】阿里云 AccessKey（仅供本地测试生成 Token）
# ⚠️ 警告：生产环境不要使用，必须从后端获取 Token
# 创建地址: https://ram.console.aliyun.com/manage/ak
NLS_ACCESS_KEY_ID=your_access_key_id_here
NLS_ACCESS_KEY_SECRET=your_access_key_secret_here

# ==========================================
# 第三方服务配置
# ==========================================
# 微信开放平台 AppID
WECHAT_APP_ID=your_wechat_app_id_here
# 微信 App Secret（仅供服务端使用，客户端不需要）
WECHAT_APP_SECRET=your_wechat_app_secret_here
# 高德地图 Key
# 申请地址: https://console.amap.com/
AMAP_KEY=your_amap_key_here
