# EvoLoop Native 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==========================================
# API 配置
# ==========================================

# 后端 API 基础地址
EXPO_PUBLIC_BASE_URL=https://evoloop.develop-assistant.cn

# Gateway WebSocket 地址
EXPO_PUBLIC_GATEWAY_URL=https://gateway.evoloop.develop-assistant.cn

# ==========================================
# 阿里云 NLS (实时语音识别) 配置
# ==========================================

# NLS AppKey（从阿里云控制台获取）
# 开通地址: https://www.aliyun.com/product/nls
EXPO_PUBLIC_NLS_APP_KEY=your_nls_app_key_here

# 【可选】阿里云 AccessKey（仅供本地测试生成 Token）
# ⚠️ 警告：生产环境不要使用，必须从后端获取 Token
# 创建地址: https://ram.console.aliyun.com/manage/ak
EXPO_PUBLIC_NLS_ACCESS_KEY_ID=your_access_key_id_here
EXPO_PUBLIC_NLS_ACCESS_KEY_SECRET=your_access_key_secret_here

# ==========================================
# 微信支付配置
# ==========================================

# 微信开放平台 AppID
EXPO_PUBLIC_WECHAT_APP_ID=your_wechat_app_id_here

# 微信 App Secret（仅供服务端使用，客户端不需要）
# EXPO_PUBLIC_WECHAT_APP_SECRET=your_wechat_app_secret_here

# ==========================================
# 应用配置
# ==========================================

# 应用名称
EXPO_PUBLIC_APP_NAME=EvoLoop

# 是否开启调试模式
EXPO_PUBLIC_DEBUG_MODE=true

# ==========================================
# 可选配置
# ==========================================

# Sentry DSN（错误追踪，可选）
# EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# 日志级别: debug | info | warn | error
EXPO_PUBLIC_LOG_LEVEL=debug
