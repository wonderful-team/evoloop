async def scenario_retry_conversation():
    """场景 2: 重试对话 — 用户重试之前失败的任务。"""
    print(f"\n{'=' * 60}")
    print("场景: 重试对话 — 用户重试之前失败的任务")
    print(f"{'=' * 60}")

    visited: list[str] = []
    call_counts: dict[str, int] = {}

    async def mock_run_node(*, state, config, system_prompt, tools, model=None, max_steps=5, name="Agent", **kwargs):
        visited.append(name)
        name_to_node = {"Session Reviewer": "Finish"}
        node_name = name_to_node.get(name, name)
        call_counts.setdefault(node_name, 0)
        idx = call_counts[node_name]
        call_counts[node_name] += 1

        if node_name == "Supervisor":
            return make_engine_result(
                messages=[AIMessage(content="Retry route to worker")],
                signal=RouteToSignal(
                    target=RoutingTarget.WORKER,
                    reason="重试之前的代码生成任务",
                    context=RoutingContext(topic="快速排序算法重试"),
                ),
            )
        if node_name == "Worker":
            return make_engine_result(
                messages=[AIMessage(content="```python\ndef quicksort(arr): ...\n# 已修复之前的错误\n```")],
                outcome=NodeOutcome(status="success"),
                routing_target=RoutingTarget.FINISH,
            )
        return EngineResult(messages=[AIMessage(content=f"Mock {name} response")])

    with ExitStack() as stack:
        stack.enter_context(patch("app.core.engine.dispatch.session_scope", side_effect=mock_session_scope))
        stack.enter_context(patch("app.infrastructure.database.sql.database.session_scope", side_effect=mock_session_scope))
        stack.enter_context(patch("app.domain.project.reference_service.reference_service.process_references", new_callable=AsyncMock, return_value=MagicMock(content_blocks="重试：帮我写一个快速排序算法")))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.start_run", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.end_run", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.check_cancellation", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.get_activity", new_callable=AsyncMock, return_value={"steps": []}))
        stack.enter_context(patch("app.core.evocloud.evocloud_manager.upload_log", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.evocloud.evocloud_manager.get_project_by_id", new_callable=AsyncMock, return_value={"path": "/tmp/test-project"}))
        stack.enter_context(patch("app.core.context.manager.ContextManager.load_from_redis", new_callable=AsyncMock, return_value=None))
        stack.enter_context(patch("app.core.context.manager.ContextManager.save_to_redis", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.is_initialized", return_value=True))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.get_container", return_value=MockMemoryContainer()))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.ainitialize", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.context_hydrator.EvoContextMiddleware.hydrate", new_callable=AsyncMock, side_effect=lambda s, c: s))
        mock_engine_cls = stack.enter_context(patch("app.core.engine.nodes.base.get_default_engine"))
        stack.enter_context(patch("app.core.engine.nodes.sequential_workflow.get_default_engine"))
        stack.enter_context(patch("app.core.tools.manager.tool_manager.get_node_tools", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.context_hydrator.SkillHydrator.get_node_skills", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.nodes.utils.skill_resolver.SkillResolver.inject_fallback_sops", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.nodes.utils.skill_resolver.SkillResolver.load_skills_by_ids", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.checkpoint.pruner.auto_prune_on_completion", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.context.manager.ContextManager.current", return_value=MagicMock(thread_id="test-thread-retry", user_id="user-1", project_id=1)))
        stack.enter_context(patch("app.core.engine.routers.route_supervisor", side_effect=_mock_route_supervisor))
        stack.enter_context(patch("app.core.engine.routers.route_by_next_node", side_effect=_mock_route_by_next_node))
        stack.enter_context(patch("app.core.engine.routers.route_finish", side_effect=_mock_route_finish))
        async def mock_audit_execute(*args, **kwargs):
            visited.append("Finish")
            return MagicMock(
                summary="审计完成：重试后代码已生成并通过检查",
                tier="minimal",
                meta={"tier": "minimal", "duration_ms": 5, "tools": []},
            )
        stack.enter_context(
            patch("app.core.engine.nodes.finish.AuditService.execute", side_effect=mock_audit_execute)
        )
        stack.enter_context(
            patch(
                "app.core.engine.hooks.core.hook_system.trigger",
                new_callable=AsyncMock,
                return_value=MagicMock(block=False),
            )
        )
        stack.enter_context(patch("app.core.events.system_bus.publish", new_callable=AsyncMock))
        stack.enter_context(patch("app.infrastructure.cache.cache.publish", new_callable=AsyncMock))
        mock_get_graph = stack.enter_context(patch("app.core.engine.background_agent.get_graph"))

        mock_engine = MagicMock()
        mock_engine.run_node = AsyncMock(side_effect=mock_run_node)
        mock_engine_cls.return_value = mock_engine

        builder = GraphBuilder()
        graph = builder.build(str(CONFIG_PATH))
        mock_get_graph.return_value = graph

        print("\n[1/3] 调用 dispatch_agent_run() with is_retry=True ...")
        result = await dispatch_agent_run(
            thread_id="test-thread-retry",
            message_content="重试：帮我写一个快速排序算法",
            project_id=1,
            model="gpt-4o",
            is_retry=True,
            skip_message_persistence=False,
        )

        if result.status != "queued":
            print(f"❌ dispatch 失败: {result.error}")
            return False

        print(f"✅ dispatch 成功 — status={result.status}, is_retry={result.inputs.get('is_retry')}")
        assert result.inputs.get("is_retry") is True, "is_retry 应被传递到 inputs"

        print("\n[2/3] 调用 run_agent_background() ...")
        await run_agent_background(result.thread_id, result.inputs)

    print("\n[3/3] 校验执行轨迹 ...")
    expected_nodes = ["Supervisor", "Worker", "Finish"]
    print(f"实际流经节点: {visited}")
    print(f"预期流经节点: {expected_nodes}")

    if visited == expected_nodes:
        print("✅ 节点流转路径正确")
    else:
        print("❌ 节点流转路径不匹配")
        return False

    print("\n✅ 重试场景验证通过！")
    return True


async def scenario_multi_turn_conversation():
    """场景 3: 多轮交互 — Worker 返回 Supervisor，Supervisor 再次分配任务后结束。"""
    print(f"\n{'=' * 60}")
    print("场景: 多轮交互 — Worker → Supervisor → Worker → Finish")
    print(f"{'=' * 60}")

    visited: list[str] = []
    call_counts: dict[str, int] = {}

    async def mock_run_node(*, state, config, system_prompt, tools, model=None, max_steps=5, name="Agent", **kwargs):
        visited.append(name)
        name_to_node = {"Session Reviewer": "Finish"}
        node_name = name_to_node.get(name, name)
        call_counts.setdefault(node_name, 0)
        idx = call_counts[node_name]
        call_counts[node_name] += 1

        if node_name == "Supervisor":
            # 第一轮 Supervisor：分配给 Worker
            # 第二轮 Supervisor：worker_outcome=success，直接 Finish（prepare_state 短路）
            return make_engine_result(
                messages=[AIMessage(content="Route to worker")],
                signal=RouteToSignal(
                    target=RoutingTarget.WORKER,
                    reason="编写排序算法",
                    context=RoutingContext(topic="排序算法"),
                ),
            )
        if node_name == "Worker":
            return make_engine_result(
                messages=[AIMessage(content="快速排序已完成。请继续分配下一个任务。")],
                outcome=NodeOutcome(status="success"),
                routing_target=RoutingTarget.SUPERVISOR,
            )
        return EngineResult(messages=[AIMessage(content=f"Mock {name} response")])

    with ExitStack() as stack:
        stack.enter_context(patch("app.core.engine.dispatch.session_scope", side_effect=mock_session_scope))
        stack.enter_context(patch("app.infrastructure.database.sql.database.session_scope", side_effect=mock_session_scope))
        stack.enter_context(patch("app.domain.project.reference_service.reference_service.process_references", new_callable=AsyncMock, return_value=MagicMock(content_blocks="先写快速排序，再写归并排序")))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.start_run", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.end_run", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.check_cancellation", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.background_agent.activity_monitor.get_activity", new_callable=AsyncMock, return_value={"steps": []}))
        stack.enter_context(patch("app.core.evocloud.evocloud_manager.upload_log", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.evocloud.evocloud_manager.get_project_by_id", new_callable=AsyncMock, return_value={"path": "/tmp/test-project"}))
        stack.enter_context(patch("app.core.context.manager.ContextManager.load_from_redis", new_callable=AsyncMock, return_value=None))
        stack.enter_context(patch("app.core.context.manager.ContextManager.save_to_redis", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.is_initialized", return_value=True))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.get_container", return_value=MockMemoryContainer()))
        stack.enter_context(patch("app.core.memory.lifespan.MemoryLifespanManager.ainitialize", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.engine.context_hydrator.EvoContextMiddleware.hydrate", new_callable=AsyncMock, side_effect=lambda s, c: s))
        mock_engine_cls = stack.enter_context(patch("app.core.engine.nodes.base.get_default_engine"))
        stack.enter_context(patch("app.core.engine.nodes.sequential_workflow.get_default_engine"))
        stack.enter_context(patch("app.core.tools.manager.tool_manager.get_node_tools", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.context_hydrator.SkillHydrator.get_node_skills", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.nodes.utils.skill_resolver.SkillResolver.inject_fallback_sops", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.nodes.utils.skill_resolver.SkillResolver.load_skills_by_ids", new_callable=AsyncMock, return_value=[]))
        stack.enter_context(patch("app.core.engine.checkpoint.pruner.auto_prune_on_completion", new_callable=AsyncMock))
        stack.enter_context(patch("app.core.context.manager.ContextManager.current", return_value=MagicMock(thread_id="test-thread-multi", user_id="user-1", project_id=1)))
        stack.enter_context(patch("app.core.engine.routers.route_supervisor", side_effect=_mock_route_supervisor))
        stack.enter_context(patch("app.core.engine.routers.route_by_next_node", side_effect=_mock_route_by_next_node))
        stack.enter_context(patch("app.core.engine.routers.route_finish", side_effect=_mock_route_finish))
        async def mock_audit_execute(*args, **kwargs):
            visited.append("Finish")
            return MagicMock(
                summary="审计完成：所有排序算法已生成",
                tier="minimal",
                meta={"tier": "minimal", "duration_ms": 5, "tools": []},
            )
        stack.enter_context(
            patch("app.core.engine.nodes.finish.AuditService.execute", side_effect=mock_audit_execute)
        )
        stack.enter_context(
            patch(
                "app.core.engine.hooks.core.hook_system.trigger",
                new_callable=AsyncMock,
                return_value=MagicMock(block=False),
            )
        )
        stack.enter_context(patch("app.core.events.system_bus.publish", new_callable=AsyncMock))
        stack.enter_context(patch("app.infrastructure.cache.cache.publish", new_callable=AsyncMock))
        mock_get_graph = stack.enter_context(patch("app.core.engine.background_agent.get_graph"))

        mock_engine = MagicMock()
        mock_engine.run_node = AsyncMock(side_effect=mock_run_node)
        mock_engine_cls.return_value = mock_engine

        builder = GraphBuilder()
        graph = builder.build(str(CONFIG_PATH))
        mock_get_graph.return_value = graph

        print("\n[1/3] 调用 dispatch_agent_run() ...")
        result = await dispatch_agent_run(
            thread_id="test-thread-multi",
            message_content="先写快速排序，再写归并排序",
            project_id=1,
            model="gpt-4o",
            skip_message_persistence=False,
        )

        if result.status != "queued":
            print(f"❌ dispatch 失败: {result.error}")
            return False

        print(f"✅ dispatch 成功 — status={result.status}")

        print("\n[2/3] 调用 run_agent_background() ...")
        await run_agent_background(result.thread_id, result.inputs)

    print("\n[3/3] 校验执行轨迹 ...")
    expected_nodes = ["Supervisor", "Worker", "Finish"]
    print(f"实际流经节点: {visited}")
    print(f"预期流经节点: {expected_nodes}")

    if visited == expected_nodes:
        print("✅ 节点流转路径正确")
    else:
        print("❌ 节点流转路径不匹配")
        return False

    print("\n✅ 多轮交互场景验证通过！")
    return True


async def main():
    print("🚀 EvoLoop Agent 端到端验证开始")
    print(f"📋 图配置: {CONFIG_PATH}")

    results = []
    results.append(await scenario_new_conversation())
    results.append(await scenario_retry_conversation())
    results.append(await scenario_multi_turn_conversation())

    print(f"\n{'=' * 60}")
    print("📊 验证汇总")
    print(f"{'=' * 60}")
    total = len(results)
    passed = sum(results)
    print(f"通过: {passed}/{total}")

    if passed == total:
        print("🎉 端到端场景验证通过！从 dispatch 入口到图执行完成链路正常。")
        return 0
    else:
        print("⚠️ 端到端场景验证失败，请检查日志。")
        return 1


if __name__ == "__main__":
    exit_code = asyncio.run(main())
    sys.exit(exit_code)
