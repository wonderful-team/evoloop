#!/usr/bin/env bash
#
# EvoLoop Client CLI 工具
# =======================
# 客户端命令行工具（CS 架构 - Client 端）
#
# 安装:
#   chmod +x evo
#   sudo ln -s $(pwd)/evo /usr/local/bin/evo
#
# 使用:
#   evo help              显示帮助
#   evo start             启动客户端守护进程
#   evo stop              停止客户端守护进程
#   evo lint              代码检查
#   evo clean             清理数据

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# 帮助信息
show_help() {
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║                  EvoLoop Client CLI 工具                     ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  【运行】                                                     ║
║    evo start            启动客户端守护进程                   ║
║    evo stop             停止客户端守护进程                   ║
║    evo restart          重启客户端守护进程                   ║
║    evo status           查看客户端运行状态                   ║
║                                                              ║
║  【代码质量】                                                 ║
║    evo lint             运行代码检查                         ║
║    evo format           格式化代码                           ║
║    evo check            全面代码检查 (lint + type)           ║
║    evo fix              自动修复代码问题                     ║
║                                                              ║
║  【数据管理】                                                 ║
║    evo clean            清理运行时缓存                       ║
║    evo clean all        完整数据清理                         ║
║    evo clean index      清理代码索引                         ║
║    evo clean memory     清理记忆数据                         ║
║                                                              ║
║  【环境】                                                     ║
║    evo install          安装依赖                             ║
║    evo doctor           检测开发环境                         ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝

注意: Client 模式使用 SQLite + LanceDB (本地存储)
      云端智能通过 WebSocket 连接 EvoLoop Cloud
EOF
}

# 打印带颜色的信息
info() { echo -e "${BLUE}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warning() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; }

# 检查 uv 是否安装
check_uv() {
    if ! command -v uv &> /dev/null; then
        error "uv 未安装，请先安装 uv: https://docs.astral.sh/uv/"
        exit 1
    fi
}

# PID 文件
PID_FILE="$PROJECT_DIR/.evoloop.pid"
LOG_FILE="$PROJECT_DIR/.evoloop.log"

# 主命令处理
case "${1:-help}" in
    help|-h|--help)
        show_help
        ;;

    # ==================== 运行 ====================
    install)
        check_uv
        info "安装依赖..."
        uv sync
        info "创建数据目录..."
        mkdir -p ~/.evoloop/data
        success "安装完成"
        ;;

    start)
        check_uv
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            warning "EvoLoop Client 已在运行 (PID: $(cat "$PID_FILE"))"
            exit 0
        fi
        info "启动 EvoLoop Client..."
        nohup uv run python bin/run.py start > "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        sleep 2
        if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            success "EvoLoop Client 启动成功 (PID: $(cat "$PID_FILE"))"
            info "日志: $LOG_FILE"
        else
            error "启动失败，查看日志: $LOG_FILE"
            rm -f "$PID_FILE"
            exit 1
        fi
        ;;

    stop)
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE")
            if kill -0 "$PID" 2>/dev/null; then
                info "停止 EvoLoop Client (PID: $PID)..."
                kill "$PID"
                rm -f "$PID_FILE"
                success "已停止"
            else
                warning "进程已不存在"
                rm -f "$PID_FILE"
            fi
        else
            warning "EvoLoop Client 未运行"
        fi
        ;;

    restart)
        $0 stop || true
        sleep 1
        $0 start
        ;;

    status)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            success "EvoLoop Client 运行中 (PID: $(cat "$PID_FILE"))"
            info "日志: $LOG_FILE"
        else
            info "EvoLoop Client 未运行"
        fi
        ;;

    logs)
        if [ -f "$LOG_FILE" ]; then
            tail -f "$LOG_FILE"
        else
            warning "日志文件不存在"
        fi
        ;;

    # ==================== 代码质量 ====================
    lint)
        check_uv
        info "运行代码检查..."
        uv run ruff check app
        ;;

    format)
        check_uv
        info "格式化代码..."
        uv run ruff format app
        uv run ruff check --select I --fix app
        ;;

    check)
        check_uv
        info "运行全面代码检查..."
        uv run ruff check app
        uv run mypy app --ignore-missing-imports
        success "检查完成"
        ;;

    fix)
        check_uv
        info "自动修复代码问题..."
        uv run ruff check --fix app
        uv run ruff format app
        success "修复完成"
        ;;

    # ==================== 数据管理 ====================
    clean)
        check_uv
        case "${2:-default}" in
            default)
                info "清理运行时缓存..."
                find app -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
                rm -rf .pytest_cache .mypy_cache .ruff_cache
                success "缓存清理完成"
                ;;
            all)
                warning "这将删除所有本地数据（SQLite、LanceDB、索引）"
                read -p "确认继续? [y/N] " -n 1 -r
                echo
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    rm -f "$PROJECT_DIR"/*.db
                    rm -rf "$PROJECT_DIR"/lancedb
                    rm -rf ~/.evoloop
                    success "所有数据已清理"
                else
                    info "已取消"
                fi
                ;;
            index)
                info "清理代码索引..."
                rm -rf "$PROJECT_DIR"/lancedb
                success "索引已清理"
                ;;
            memory)
                info "清理记忆数据..."
                # TODO: 实现记忆清理
                warning "TODO: 实现记忆清理"
                ;;
            *)
                error "未知清理目标: $2"
                echo "可用目标: default, all, index, memory"
                exit 1
                ;;
        esac
        ;;

    # ==================== 环境 ====================
    doctor)
        info "检查开发环境..."

        # 检查 uv
        if command -v uv &> /dev/null; then
            success "uv: $(uv --version)"
        else
            error "uv: 未安装"
        fi

        # 检查 Python
        if command -v python3 &> /dev/null; then
            success "Python: $(python3 --version)"
        else
            error "Python: 未安装"
        fi

        # 检查 .env
        if [ -f "$PROJECT_DIR/../.env" ]; then
            success ".env: 已配置"
        else
            warning ".env: 未找到，请复制 .env.example"
        fi

        # 检查虚拟环境
        if [ -d "$PROJECT_DIR/.venv" ]; then
            success "虚拟环境: 已创建"
        else
            warning "虚拟环境: 未创建，运行 'evo install'"
        fi

        success "检查完成"
        ;;

    # ==================== 未知命令 ====================
    *)
        error "未知命令: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
