# =============================================================================
# EvoLoop 全局环境变量模板 (Single Source of Truth)
# =============================================================================
# 本文件包含了项目所有的配置项，包括后端、Web前端、Tauri桌面端、移动端。
# 请复制此文件为 .env (用于存放真实密钥) 
# 或依据需要修改 .env.dev 和 .env.prod。

# -----------------------------------------------------------------------------
# 1. 后端与服务基础配置 (Backend)
# -----------------------------------------------------------------------------
ENVIRONMENT=local
PORT=20160
EVOLOOP_APP_DATA_DIR=~/.evoloop

# 是否开启多租户模式 (单用户/多租户)
MULTI_TENANT_MODE=false

# 是否开启移动端同步功能 (允许手机扫码连接电脑端)
MOBILE_SYNC_ENABLED=false

# 是否启用本地环境控制工具 (浏览器、桌面控制等，纯服务器建议关，桌面端建议开)
ENABLE_ENVIRONMENT_CONTROLS=false

# 代码沙盒执行模式 (local / docker)
EXECUTION_MODE=local

# 数据库 (如果是桌面端 EMBEDDED_MODE=true，则自动使用 SQLite，不需要填以下地址)
EMBEDDED_MODE=true
POSTGRES_SERVER=
NEO4J_URI=
REDIS_URL=

# AI 模型配置 (桌面推荐本地模型)
LLM_API_KEY=lm-studio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# 2. 前端 / 桌面端配置 (Vite & Tauri)
#    注意: 前端变量必须以 VITE_ 开头
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173

# API 请求地址 (本地开发填 127.0.0.1，上线填域名)
VITE_API_URL=http://127.0.0.1:20160
VITE_EVOCLOUD_MEMBER_BASE_URL=https://evoloop.develop-assistant.cn/member
VITE_STARTUP_DEBUG_MODE=true
VITE_AMAP_KEY=8fee0670ba8e3655efeb623e264fd2c0

# -----------------------------------------------------------------------------
# 3. 移动端配置 (React Native)
# -----------------------------------------------------------------------------
VITE_EVOCLOUD_API_URL=https://evoloop.develop-assistant.cn
VITE_EVOLOOP_WS_URL=wss://evoloop.develop-assistant.cn/gateway/ws
