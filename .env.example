# =============================================================================
# EvoLoop Environment Configuration
# =============================================================================
# Copy this file to .env and modify values as needed
# cp .env.example .env

# =============================================================================
# Core Settings
# =============================================================================

DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local

PROJECT_NAME="Evoloop Project"
STACK_NAME=evoloop-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
# Generate a strong key with: openssl rand -base64 32
SECRET_KEY=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# =============================================================================
# Mode Selection (CRITICAL)
# =============================================================================
# EMBEDDED_MODE=true  →  SQLite + LanceDB + LocalCelery (no external deps)
# EMBEDDED_MODE=false →  PostgreSQL + Neo4j + Redis (full stack)
EMBEDDED_MODE=true

# =============================================================================
# Embedded Mode Settings (when EMBEDDED_MODE=true)
# =============================================================================
# SQLite database file location
SQLITE_PATH=~/.evoloop/backend.db

# LanceDB vector storage location
LANCEDB_PATH=~/.evoloop/lancedb

# =============================================================================
# Full Mode Settings (when EMBEDDED_MODE=false)
# =============================================================================
# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888
USE_NEO4J=true

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=true

# =============================================================================
# External Services
# =============================================================================

SENTRY_DSN=

# Docker
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# LLM Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BRAVE_API_KEY=

# EvoCloud API
EVOCLOUD_API_URL=https://mall.imagicbox.cn
VITE_EVOCLOUD_API_URL=https://mall.imagicbox.cn
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=

# Project Management
WORKSPACE_ROOT=

# Browser Control (Playwright/CDP)
EVOLOOP_CHROME_CDP_URL=http://localhost:9222
EVOLOOP_CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EVOLOOP_CHROME_USER_DATA="~/Library/Application Support/Google/Chrome"
EVOLOOP_CHROME_AUTOMATION_USER_DATA="~/Library/Application Support/Google/Chrome-Automation"
EVOLOOP_CHROME_PROFILE=Default
EVOLOOP_CHROME_STARTUP_TIMEOUT=5

# Frontend
VITE_API_URL=http://127.0.0.1:8000
VITE_EVOCLOUD_MEMBER_URL=https://mall.imagicbox.cn/h5/pages/member/index
VITE_STARTUP_DEBUG_MODE=false
MAILCATCHER_HOST=http://127.0.0.1:1080

# =============================================================================
# EvoLoop Core Configuration
# =============================================================================

# Logging
LOG_LEVEL=INFO

# Execution Sandbox: local | docker
EXECUTION_MODE=docker
SANDBOX_IMAGE=evoloop-sandbox

# File Upload
UPLOAD_DIR=/tmp/evoloop/uploads

# =============================================================================
# Feature Toggles
# =============================================================================

# Wiki generation
WIKI_EXTRACT_CONCEPTS=true

# Search optimization
ENABLE_QUERY_REWRITING=true

# Vision & OCR
ENABLE_VISION_OCR=true
ENABLE_MACRO_SELF_HEALING=false

# Use Neo4j for memory (vs flat file)
USE_NEO4J_MEMORY=false

# =============================================================================
# LLM & AI Configuration
# =============================================================================

# Embedding Configuration
# Provider: openai | ollama | dashscope | huggingface | local
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=

# SSM (Semantic Service Model)
SSM_DRIVER_TYPE=remote_api
SSM_MODEL_NAME=qwen/qwen3-vl-4b
SSM_API_BASE=http://localhost:1234/v1
REFLECTIVE_DRIVER_TYPE=active

# Agent Step Limits
SUPERVISOR_AGENT_MAX_STEPS=100
WORKER_AGENT_MAX_STEPS=2000
FINISH_AGENT_MAX_STEPS=30

# Learning / Skill Synthesis
MAX_KEYFRAMES=100

# =============================================================================
# Memory & Search Parameters
# =============================================================================

# Search
DEFAULT_SEARCH_TOP_K=10
MAX_SEARCH_DEPTH=3
MIN_RELEVANCE_SCORE=0.6

# Chunking
DEFAULT_CHUNK_SIZE=1000
MAX_CHUNK_SIZE=4000
DEFAULT_CHUNK_OVERLAP=200

# Memory
MAX_SESSION_HISTORY=20
MEMORY_RELEVANCE_THRESHOLD=0.75
MAX_MEMORY_ITEMS=1000

# LangGraph
RECURSION_LIMIT=100

# =============================================================================
# Example Configurations
# =============================================================================

# --- Quick Start (Embedded Mode, No Docker) ---
# EMBEDDED_MODE=true
# PROJECT_NAME=EvoLoop
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# EXECUTION_MODE=local

# --- Production (Full Mode, All Services) ---
# EMBEDDED_MODE=false
# POSTGRES_SERVER=db.example.com
# POSTGRES_PASSWORD=secure-password
# NEO4J_URI=bolt://neo4j.example.com:7687
# NEO4J_PASSWORD=secure-password
# REDIS_URL=redis://redis.example.com:6379/0
