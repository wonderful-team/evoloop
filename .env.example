# =============================================================================
# EvoLoop 全局环境变量模板 (Single Source of Truth)
# =============================================================================
# 使用方式:
#   cp .env.example .env        # 本地开发
#   cp .env.example .env.prod   # 生产部署
#
# 各端按需加载：
#   - 后端 Python (Pydantic):  backend/app/core/config.py
#   - 前端 Vite:               frontend/packages/desktop/
#   - 桌面端 Tauri (Rust):     frontend/src-tauri/
#   - 移动端 React Native:     mobile/ (通过 babel 读取 ../.env)
#   - Docker Compose:          docker-compose.yml

# =============================================================================
# 🟢 1. 全局通用 (Global)
# =============================================================================

# 运行环境: local / staging / production
ENVIRONMENT=local

# =============================================================================
# 🔵 2. 后端核心 (Backend Core)
# =============================================================================

# 服务监听地址和端口
HOST=127.0.0.1
PORT=20160

# JWT 签名密钥 (生产环境务必更换为随机字符串)
SECRET_KEY=

# API 路由前缀
API_V1_STR=/api/v1

# Token 过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# 调试日志
LOG_LEVEL=INFO

# 错误追踪 (Sentry)
SENTRY_DSN=

# 后端 CORS 允许的来源 (逗号分隔)
BACKEND_CORS_ORIGINS=
FRONTEND_HOST=http://localhost:5173

# 应用元数据
SERVICE_NAME=EvoLoop

# =============================================================================
# 🟣 3. 后端 - 数据库 (Backend Database)
# =============================================================================

# 内嵌模式 (桌面端): 使用 SQLite，无需外部数据库
EMBEDDED_MODE=true
EVOLOOP_APP_DATA_DIR=~/.evoloop
SQLITE_DB_PATH=
SQLITE_PATH=

# 外部 PostgreSQL (非内嵌模式时需要)
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 向量数据库 (PostgreSQL + pgvector)
VECTOR_POSTGRES_SERVER=
VECTOR_POSTGRES_PORT=5432
VECTOR_POSTGRES_USER=
VECTOR_POSTGRES_PASSWORD=
VECTOR_POSTGRES_DB=

# 图数据库 (Neo4j)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 缓存 (Redis)
REDIS_URL=
REDIS_MAX_CONNECTIONS=120

# =============================================================================
# 🟡 4. 后端 - AI & 模型 (Backend AI / LLM)
# =============================================================================

# Embedding 模型维度
EMBEDDING_DIMENSIONS=768

# 模型文件下载目录
MODELS_DIR=

# HuggingFace 镜像
HF_ENDPOINT=https://huggingface.co

# 语音合成 (TTS)
TTS_PROVIDER=auto
TTS_DEFAULT_VOICE=zh-CN-Tingting
TTS_DEFAULT_SPEED=1.0

# 语音识别 (ASR)
FUNASR_MODEL=paraformer-zh
FUNASR_DEVICE=cpu

# =============================================================================
# 🟠 5. 后端 - 云服务连接 (Backend EvoCloud)
# =============================================================================

# EvoCloud 云端 API 地址
EVOCLOUD_API_URL=https://evoloop.cn
EVOCLOUD_WS_URL=ws://evoloop.cn/gateway/ws

# 设备注册凭证 (用于连接云端)
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=
EVOCLOUD_ACCESS_TOKEN=
EVOCLOUD_DEVICE_NAME=EvoLoop-Desktop

# SSL 校验 (仅开发环境可关闭)
EVOCLOUD_SSL_VERIFY=true

# 多端同步
MOBILE_SYNC_ENABLED=false

# =============================================================================
# 🟤 6. 后端 - 搜索 & 工具 (Backend Search & Tools)
# =============================================================================

# 搜索引擎 (auto / meilisearch)
SEARCH_ENGINE=auto
SEARCH_DB_PATH=

# MeiliSearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# Web 搜索 API
GOOGLE_API_KEY=
BRAVE_API_KEY=

# 自建知识库
KNOWLEDGE_BASE_PATH=

# =============================================================================
# 🔴 7. 后端 - 浏览器控制 (Backend Chrome Automation)
# =============================================================================

# Chrome DevTools Protocol (CDP)
EVOLOOP_CHROME_CDP_URL=http://localhost:9222
EVOLOOP_CHROME_EXECUTABLE=
EVOLOOP_CHROME_USER_DATA=
EVOLOOP_CHROME_AUTOMATION_USER_DATA=
EVOLOOP_CHROME_PROFILE=Default
EVOLOOP_CHROME_STARTUP_TIMEOUT=5

# =============================================================================
# 🟢 8. 后端 - 功能开关 (Backend Feature Flags)
# =============================================================================

# 执行模式: local / docker (沙盒隔离代码执行)
EXECUTION_MODE=local
SANDBOX_IMAGE=evoloop-sandbox

# 多租户
MULTI_TENANT_MODE=false

# 桌面环境控制 (浏览器、文件系统等)
ENABLE_ENVIRONMENT_CONTROLS=true

# 截图 / 录屏
ENABLE_PARTIAL_SCREENSHOT=true
ENABLE_VISION_OCR=true

# 记忆系统
AUTO_MEMORY_EXTRACTION=true
AUTO_MEMORY_EXTRACTION_INTERVAL=1

# 搜索增强
ENABLE_QUERY_REWRITING=true

# 宏自愈
ENABLE_MACRO_SELF_HEALING=true

# 智能体协议
DYNAMIC_PROTOCOL_LOADING=false
PROTOCOL_MATCHER_THRESHOLD=0.7
PROTOCOL_LOADER_CACHE_TTL=300

# =============================================================================
# 🔵 9. 后端 - 逻辑限制 (Backend Limits & Thresholds)
# =============================================================================

# RAG 检索
DEFAULT_SEARCH_TOP_K=10
MAX_SEARCH_DEPTH=3
MIN_RELEVANCE_SCORE=0.6

# 文本分块
DEFAULT_CHUNK_SIZE=1000
MAX_CHUNK_SIZE=4000
DEFAULT_CHUNK_OVERLAP=200

# 记忆
MAX_SESSION_HISTORY=20
MEMORY_RELEVANCE_THRESHOLD=0.75
MAX_MEMORY_ITEMS=1000
MEMORY_SEARCH_LIMIT=5

# Agent 步数
SUPERVISOR_AGENT_MAX_STEPS=20
WORKER_AGENT_MAX_STEPS=50
FINISH_AGENT_MAX_STEPS=10
LONG_HORIZON_SUPERVISOR_MAX_STEPS=100
LONG_HORIZON_RECURSION_LIMIT=250

# 研究 / 递归
RESEARCH_MAX_ITERATIONS=5
RECURSION_LIMIT=100
TREE_VIEW_MAX_LINES=1500

# 技能合成
MAX_KEYFRAMES=50

# =============================================================================
# 🟣 10. 后端 - 截图 / 录屏保留 (Backend Media Retention)
# =============================================================================

SCREENSHOT_TEMP_RETENTION_DAYS=1
SCREENSHOT_DEBUG_RETENTION_DAYS=7
SCREENSHOT_ATLAS_RETENTION_DAYS=90
SCREENSHOT_DATASET_RETENTION_DAYS=365
SCREEN_RECORDING_RETENTION_DAYS=30
SCREEN_RECORDING_MAX_SIZE_GB=10
SCREEN_RECORDING_MAX_DURATION_MIN=10
SCREEN_RECORDING_MAX_SIZE_MB=500

# =============================================================================
# ⚪ 11. 后端 - 邮件 (Backend SMTP)
# =============================================================================

SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=EvoLoop
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# =============================================================================
# 🟠 12. 后端 - 文件上传 & 路径安全 (Backend Upload & Security)
# =============================================================================

UPLOAD_DIR=
ALLOWED_PATH_PREFIXES=["/tmp/dataset","/tmp/evoloop"]

# =============================================================================
# ⚪ 13. 后端 - 数据库连接池 (Backend DB Pool)
# =============================================================================

DB_ECHO=false
DB_CONNECT_TIMEOUT=99.5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CHECKPOINTER_POOL_SIZE=5

# =============================================================================
# 🟢 14. 前端 / 桌面端 (Frontend Vite & Tauri)
# =============================================================================

# Vite 开发服务器端口
FRONTEND_PORT=5173

# API 地址 (开发填 http://127.0.0.1:20160，上线填域名)
VITE_API_URL=http://127.0.0.1:20160

# EvoCloud 会员服务地址
VITE_EVOCLOUD_MEMBER_BASE_URL=${EVOCLOUD_API_URL}/member

# 调试模式 (启动时显示调试信息)
VITE_STARTUP_DEBUG_MODE=false

# 高德地图 API Key
VITE_AMAP_KEY=8fee0670ba8e3655efeb623e264fd2c0

# Tauri (Rust) 构建时注入 (一般来自 CI/CD)
APP_VERSION=0.1.0
BUILD_NUMBER=1
BUILD_TIME=
GIT_COMMIT=unknown
RELEASE_STAGE=alpha

# Tauri sidecar 后端端口 (编译时注入)
EVOLOOP_BACKEND_PORT=20160

# =============================================================================
# 🟡 15. 移动端 (Mobile React Native)
# =============================================================================
# 移动端通过 react-native-dotenv 从根目录 .env 读取

# 应用显示名称
APP_NAME=EvoLoop

# API 和 WebSocket (与后端共用 EVOCLOUD_API_URL / EVOCLOUD_WS_URL)
# 注意: 移动端不读 VITE_ 前缀的变量
#   EVOCLOUD_API_URL  — 见第 5 节
#   EVOCLOUD_WS_URL   — 见第 5 节

# 微信登录 / 支付
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Universal Link (微信开放平台配置)
EVOCLOUD_UNIVERSAL_LINK_URL=https://evoloop.cn/universal-link

# 阿里云语音识别 (NLS)
NLS_APP_KEY=
NLS_WS_URL=

# 阿里云百炼 TTS (DashScope)
DASHSCOPE_API_KEY=

# 高德地图 (移动端)
AMAP_KEY=

# =============================================================================
# 🔴 16. Docker Compose 部署 (Docker Deployment)
# =============================================================================

# 域名 (用于反向代理和 HTTPS)
DOMAIN=

# Docker 前端端口映射
FRONTEND_DOCKER_PORT=5173

# =============================================================================
# ⚪ 17. 构建 / CI (Build & CI/CD)
# =============================================================================

# 构建输出目录 (前端)
VITE_OUTPUT_DIR=dist

# macOS 构建目标
MACOSX_DEPLOYMENT_TARGET=10.15
ARCH=aarch64-apple-darwin
LIBRARY_PATH=

# 前端 Playwright 测试
CI=
