# Domain
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local

PROJECT_NAME="Evoloop Project"
STACK_NAME=evoloop-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
# Generate a strong key with: openssl rand -base64 32
SECRET_KEY=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

SENTRY_DSN=

# Docker
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# --- EvoLoop Configuration ---
APP_ENV=development
LOG_LEVEL=INFO

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# LLM Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
EMBEDDING_MODEL_NAME=text-embedding-3-small

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BRAVE_API_KEY=

BROWSER_MODEL_NAME=gpt-4o
BROWSER_USE_API_KEY=

# Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434

# EvoCloud API
EVOCLOUD_API_URL=https://mall.imagicbox.cn
VITE_EVOCLOUD_API_URL=https://mall.imagicbox.cn
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=

# Project Management
PROJECTS_ROOT=

# Browser Control (Playwright/CDP)
EVOLOOP_CHROME_CDP_URL=http://localhost:9222
EVOLOOP_CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EVOLOOP_CHROME_USER_DATA="~/Library/Application Support/Google/Chrome"
EVOLOOP_CHROME_AUTOMATION_USER_DATA="~/Library/Application Support/Google/Chrome-Automation"
EVOLOOP_CHROME_PROFILE=Default
EVOLOOP_CHROME_STARTUP_TIMEOUT=5

# Frontend
VITE_API_URL=http://127.0.0.1:8000
MAILCATCHER_HOST=http://127.0.0.1:1080
