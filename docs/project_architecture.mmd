graph TB
    subgraph "EvoLoop 项目管理系统"
        subgraph "API Layer"
            API1[projects.py]
            API2[tasks.py]
            API3[todos.py]
            API4[project_requirements.py]
            API5[planning.py]
        end
        
        subgraph "Domain Services"
            SVC1[ProjectContextManager]
            SVC2[project_sync_service]
            SVC3[discovery_manager]
            SVC4[RequirementService]
        end
        
        subgraph "Models - Local SQLite"
            DB1[(Repositories)]
            DB2[(TodoItem)]
            DB3[(Plan/PlanStep)]
            DB4[(AutonomousTask)]
            DB5[(Requirements)]
            DB6[(Conversations)]
        end
        
        subgraph "Models - EvoCloud"
            CLOUD1[(Projects)]
            CLOUD2[(Tasks)]
            CLOUD3[(Budget)]
            CLOUD4[(Timesheet)]
        end
        
        subgraph "External"
            WS[Workspace Root]
            GIT[Git Repos]
            AGENT[AI Agent]
        end
    end
    
    API1 --> SVC1
    API1 --> SVC2
    API2 --> CLOUD2
    API3 --> DB2
    API4 --> SVC4
    API5 --> DB3
    
    SVC1 --> DB1
    SVC1 --> WS
    SVC2 --> CLOUD1
    SVC2 --> DB1
    SVC3 --> WS
    SVC4 --> DB5
    SVC4 --> CLOUD2
    
    DB1 --> GIT
    AGENT --> DB3
    AGENT --> DB6
    
    style CLOUD1 fill:#f9f,stroke:#333
    style CLOUD2 fill:#f9f,stroke:#333
    style CLOUD3 fill:#f9f,stroke:#333
    style CLOUD4 fill:#f9f,stroke:#333
    style DB2 fill:#bbf,stroke:#333
    style DB3 fill:#bbf,stroke:#333
    style DB4 fill:#bbf,stroke:#333
