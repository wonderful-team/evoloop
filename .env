# =============================================================================
# EvoLoop 环境变量配置
# =============================================================================

PROJECT_NAME="Evoloop Project"
STACK_NAME=evoloop-project

# =============================================================================
# 1. 项目与部署 (Docker / Backend / Frontend 共用)
# =============================================================================

# 部署域名，用于 Traefik 路由和 TLS 证书
DOMAIN=localhost
# DOMAIN=localhost.tiangolo.com

# 前端访问地址，Backend 生成邮件/链接时使用
FRONTEND_HOST=http://localhost:5173
# Frontend Nginx Docker 端口映射
FRONTEND_DOCKER_PORT=8080

# Backend API 服务端口
PORT=20160
# 运行环境: local | staging | production
ENVIRONMENT=local

# =============================================================================
# 2. 运行模式 (核心架构开关)
# =============================================================================
# EMBEDDED_MODE=true  → SQLite + LanceDB + LocalCelery (无外部依赖，推荐本地开发)
# EMBEDDED_MODE=false → PostgreSQL + Neo4j + Redis (完整技术栈，生产环境)
EMBEDDED_MODE=true

# 嵌入式模式数据库路径 (仅 EMBEDDED_MODE=true 时生效)
SQLITE_PATH=~/.evoloop/backend.db
LANCEDB_PATH=~/.evoloop/lancedb

# =============================================================================
# 3. 安全与认证 (Backend)
# =============================================================================

# 密钥，用于 JWT 签名和 Session 加密
# 生成强密钥: openssl rand -base64 32
SECRET_KEY=evoloop_secure_key_32_bytes_long_minimum

# CORS 允许的前端地址，多个用逗号分隔
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"

# =============================================================================
# 4. 数据库与存储 (Backend / Docker)
# =============================================================================

# PostgreSQL (仅 EMBEDDED_MODE=false 时生效)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

# Neo4j 图数据库 (仅 EMBEDDED_MODE=false 时生效)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
USE_NEO4J=true

# =============================================================================
# 5. 缓存与消息队列 (Backend)
# =============================================================================

# Redis (仅 EMBEDDED_MODE=false 时生效)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
USE_REDIS=true

# =============================================================================
# 6. AI 模型与外部服务 (Backend)
# =============================================================================

# 日志级别: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# LLM Provider
# 注意: 所有 AI Provider 配置也可通过 SystemConfigService (DB) 或 Admin UI 设置
LLM_API_KEY=lm-studio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model

# Embedding
EMBEDDING_DIMENSIONS=768
HF_ENDPOINT=https://huggingface.co

# 搜索增强
GOOGLE_API_KEY=
BRAVE_API_KEY=

# =============================================================================
# 7. EvoCloud 平台集成 (Backend / Frontend 共用)
# =============================================================================

# EvoCloud API 地址 (会员中心 Gateway)
EVOCLOUD_API_URL=https://evoloop.develop-assistant.cn
EVOCLOUD_WS_URL=wss://evoloop.develop-assistant.cn/gateway/ws

# EvoCloud API 认证 (从 EvoCloud 后台获取)
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=

# SSL 证书验证 (开发环境可设为 false，生产环境必须为 true)
EVOCLOUD_SSL_VERIFY=true

# =============================================================================
# 8. Agent 与执行引擎 (Backend)
# =============================================================================

# 执行沙箱模式: local | docker
EXECUTION_MODE=local
SANDBOX_IMAGE=evoloop-sandbox

# Agent 最大步数限制
SUPERVISOR_AGENT_MAX_STEPS=30
WORKER_AGENT_MAX_STEPS=100
FINISH_AGENT_MAX_STEPS=10

# 视觉与 OCR
ENABLE_VISION_OCR=true
ENABLE_MACRO_SELF_HEALING=false

# 视频/动画关键帧最大数量
MAX_KEYFRAMES=100

# 语义服务模型 (SSM)
# SSM_DRIVER_TYPE=remote_api
# SSM_MODEL_NAME=
# SSM_API_BASE=
REFLECTIVE_DRIVER_TYPE=active

# 搜索与分片
DEFAULT_SEARCH_TOP_K=10
MAX_SEARCH_DEPTH=3
MIN_RELEVANCE_SCORE=0.6
DEFAULT_CHUNK_SIZE=1000
MAX_CHUNK_SIZE=4000
DEFAULT_CHUNK_OVERLAP=200

# 记忆系统
MAX_SESSION_HISTORY=20
MEMORY_RELEVANCE_THRESHOLD=0.75
MAX_MEMORY_ITEMS=1000
USE_NEO4J_MEMORY=false

# LangGraph 递归限制
RECURSION_LIMIT=100

# Wiki 生成
WIKI_EXTRACT_CONCEPTS=true
ENABLE_QUERY_REWRITING=true

# =============================================================================
# 10. 浏览器自动化 (Backend)
# =============================================================================

EVOLOOP_CHROME_CDP_URL=http://localhost:9222
EVOLOOP_CHROME_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EVOLOOP_CHROME_USER_DATA="~/Library/Application Support/Google/Chrome"
EVOLOOP_CHROME_AUTOMATION_USER_DATA="~/Library/Application Support/Google/Chrome-Automation"
EVOLOOP_CHROME_PROFILE=Default
EVOLOOP_CHROME_STARTUP_TIMEOUT=5

# =============================================================================
# 11. 邮件与通知 (Backend)
# =============================================================================

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587

# Sentry 错误追踪 (可选)
# SENTRY_DSN=

# =============================================================================
# 12. 开发工具与调试
# =============================================================================

# 本地项目根目录 (用于代码分析和文件操作)

# MailCatcher 调试邮件服务地址
MAILCATCHER_HOST=http://127.0.0.1:1080

# 文件上传临时目录
UPLOAD_DIR=/tmp/evoloop/uploads

# =============================================================================
# 13. Docker 镜像 (Docker Compose)
# =============================================================================

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# =============================================================================
# 14. 版本信息 (CI/CD 自动填充)
# =============================================================================

APP_VERSION=0.1.0
BUILD_NUMBER=1
RELEASE_STAGE=alpha
BUILD_TIME=
GIT_COMMIT=
