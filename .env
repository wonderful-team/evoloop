# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Evoloop Project"
STACK_NAME=evoloop-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=evoloop_secure_key_32_bytes_long_minimum

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# --- EvoLoop Configuration ---
LOG_LEVEL=INFO

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# LLM Providers
OPENAI_API_KEY=lm-studio
#OPENAI_API_KEY=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
OPENAI_BASE_URL=http://localhost:1234/v1
#OPENAI_BASE_URL=https://openrouter.ai/api/v1
#OPENAI_MODEL_NAME=openai/gpt-4o
OPENAI_MODEL_NAME=local-model
EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BRAVE_API_KEY=

# EvoCloud API
EVOCLOUD_API_URL=https://mall.imagicbox.cn
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=
VITE_EVOCLOUD_API_URL=https://mall.imagicbox.cn
VITE_EVOCLOUD_MEMBER_URL=https://mall.imagicbox.cn/h5/pages/member/index

# Project Management
WORKSPACE_ROOT=/Users/huangjinhuan/项目

# Frontend
VITE_API_URL=http://127.0.0.1:8000
MAILCATCHER_HOST=http://127.0.0.1:1080

# Sandbox
EXECUTION_MODE=docker

# Cognitive Brain
SSM_DRIVER_TYPE=remote_api
SSM_MODEL_NAME=qwen/qwen3-vl-4b
SSM_API_BASE=http://localhost:1234/v1

SUPERVISOR_AGENT_MAX_STEPS=100
WORKER_AGENT_MAX_STEPS=2000
FINISH_AGENT_MAX_STEPS=30

ENABLE_VISION_OCR=1
ENABLE_MACRO_SELF_HEALING=0

MAX_KEYFRAMES=100

EMBEDDED_MODE=true