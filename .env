# =============================================================================
# EvoLoop — 本地调试版
# =============================================================================

# =============================================================================
# Backend — Core
# =============================================================================
HOST=127.0.0.1
RELOAD=true
LOG_LEVEL=INFO
DB_ECHO=false
EMBEDDED_MODE=true
ENABLE_ENVIRONMENT_CONTROLS=true
EVOCLOUD_SSL_VERIFY=false

# 关闭代码库文件监控（watchdog），减少 macOS FSEvents 噪声
ENABLE_CODEBASE_FILE_WATCHER=false

# 增大连接池，缓解高并发 Agent run 下的池耗尽
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Embedding
# =============================================================================
EMBEDDING_ENABLED=false

# =============================================================================
# Backend — EvoCloud
# =============================================================================
EVOCLOUD_API_URL=https://evoloop.cn
EVOCLOUD_WS_URL=wss://evoloop.cn/gateway/ws
EVOCLOUD_UNIVERSAL_LINK_URL=https://evoloop.cn/universal-link
MOBILE_SYNC_ENABLED=true
MULTI_TENANT_MODE=false

# =============================================================================
# Frontend — Vite & Tauri
# =============================================================================
VITE_STARTUP_DEBUG_MODE=true
VITE_API_URL=http://127.0.0.1:20160
VITE_AMAP_KEY=8fee0670ba8e3655efeb623e264fd2c0

# 宿主上下文桥 origin 白名单（main.tsx initHostContextBridge）
# 9003 = Member Center 宿主后端开发地址；5173 = e2e 同源宿主模拟页
VITE_HOST_ORIGINS=http://localhost:9003,http://127.0.0.1:9003,http://localhost:5173,http://127.0.0.1:5173

# 开启 LLM 润色
EVOLOOP_DICTATION_LLM_POLISH=true

# =============================================================================
# Mobile
# =============================================================================
WECHAT_APP_ID=wx23dc5558444e6876
WECHAT_APP_SECRET=6b124434e62367e26858399a81229316
NLS_APP_KEY=N91ExoPKfdsVMEte
NLS_WS_URL=wss://nls-gateway.aliyuncs.com/ws/v1
DASHSCOPE_API_KEY=sk-39bddeb06c784ae38e2144e090b7783d
AMAP_KEY=b0c12770ebc298f44f4aaa28e9f59e02

