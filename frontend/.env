# EvoLoop Frontend 环境变量配置

# Frontend Dev Server 端口
FRONTEND_PORT=5173

# 此文件通过 Vite 注入到前端构建中
# 注意: 只有以 VITE_ 开头的变量会被暴露到客户端代码
#
# 变量按子包分类，desktop 和 mobile 共用此文件

# =============================================================================
# Desktop 包 (packages/desktop)
# =============================================================================

# Desktop Agent 本地 Backend API
VITE_API_URL=http://127.0.0.1:20160

# EvoCloud 会员中心 H5 页面地址
VITE_EVOCLOUD_MEMBER_URL=https://evoloop.develop-assistant.cn/member/h5/pages/member/index

# 启动页调试模式 (true/false)
VITE_STARTUP_DEBUG_MODE=false

# 高德地图 JS API Key
# 申请地址: https://console.amap.com/
VITE_AMAP_KEY=

# =============================================================================
# Mobile 包 (packages/mobile)
# =============================================================================

# EvoCloud API 基础地址
VITE_EVOCLOUD_API_URL=https://evoloop.develop-assistant.cn

# Gateway WebSocket 地址
VITE_EVOLOOP_WS_URL=wss://evoloop.develop-assistant.cn/gateway/ws
