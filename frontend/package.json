{
  "name": "evoloop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd packages/desktop && vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "lint:mobile": "npx eslint src/mobile --config eslint.mobile.config.mjs",
    "preview": "cd packages/desktop && vite preview",
    "generate-client": "cd ../backend/ && uv run export_openapi.py && cd ../frontend/ && openapi-ts",
    "tauri": "tauri",
    "tauri:mobile": "tauri android dev --config src-tauri/tauri.mobile.conf.json",
    "dev:mobile": "cd packages/mobile && vite --port 5174",
    "mobile:android": "export JAVA_HOME=$(/usr/libexec/java_home -v 17) && npm run tauri:mobile",
    "build:android": "export JAVA_HOME=$(/usr/libexec/java_home -v 17) && tauri android build --config src-tauri/tauri.mobile.conf.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
