# =============================================================================
# EvoLoop 环境变量配置 — CentOS 服务器部署
# =============================================================================
# 用法:
#   cp config/server/.env.example .env
#   修改必要参数后执行: bash scripts/deploy.sh --host=<IP>
#
# 部署架构:
#   中间件 → Docker (项目根目录 docker-compose.yml)
#   应用层 → 宿主机 systemd (uv run)
#
# 服务器部署分为两种模式：
#   单用户版: MULTI_TENANT_MODE=false, MOBILE_SYNC_ENABLED=false
#   多租户版: MULTI_TENANT_MODE=true,  MOBILE_SYNC_ENABLED=true (需连接移动端)
# =============================================================================

# =============================================================================
# 1. 项目与部署
# =============================================================================
DOMAIN=your-domain.com
FRONTEND_HOST=https://your-domain.com
FRONTEND_DOCKER_PORT=8080
PORT=20160
ENVIRONMENT=production
PROJECT_NAME="EvoLoop"
STACK_NAME=evoloop

# =============================================================================
# 2. 运行模式（核心架构开关）
# =============================================================================
# 服务器模式: PostgreSQL + Neo4j + Redis + Celery + Meilisearch (全栈)
# 桌面模式:   SQLite + LanceDB + Huey (零外部依赖，仅客户端用)
EMBEDDED_MODE=false

# =============================================================================
# 3. 部署形态（重要！请按需选择）
# =============================================================================
#
# ┌─────────────────────┬─────────────────────┬──────────────────────┐
# │      配置项          │  单用户私有部署       │  多租户 SaaS 部署    │
# ├─────────────────────┼─────────────────────┼──────────────────────┤
# │ MULTI_TENANT_MODE   │ false               │ true                 │
# │ MOBILE_SYNC_ENABLED │ false               │ true                 │
# │ 典型场景            │ 企业内网单实例        │ 云平台多用户服务     │
# └─────────────────────┴─────────────────────┴──────────────────────┘
#

# 多租户模式（SaaS）
#   true  → 严格 token 隔离，每个用户独立会话缓存，移动端可绑定
#   false → 单用户模式（允许全局缓存），适合私服/企业内网
MULTI_TENANT_MODE=false

# 移动端同步
#   true  → 开启 WebSocket 连接、对话同步、设备注册（多租户+移动客户端的场景）
#   false → 纯服务器部署，不接入移动端
#   注意: config.py 默认值为 true，此处显式设为 false 以关闭
MOBILE_SYNC_ENABLED=false

# 统一应用数据目录
EVOLOOP_APP_DATA_DIR=~/.evoloop

# =============================================================================
# 4. 安全与认证
# =============================================================================
# 生成强密钥: openssl rand -base64 32
SECRET_KEY=replace-with-random-secret

BACKEND_CORS_ORIGINS="https://your-domain.com,https://admin.your-domain.com"

# =============================================================================
# 4. 数据库 (PostgreSQL + pgvector)
# =============================================================================
# 注意: 本机 5432 被 sub2api 占用，共享 compose 使用 5433
# sub2api 迁走后可改回 5432
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=evoloop
POSTGRES_USER=evoloop
POSTGRES_PASSWORD=admin888

# =============================================================================
# 5. 图数据库 (Neo4j)
# =============================================================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# =============================================================================
# 6. 搜索引擎 (Meilisearch)
# =============================================================================
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=replace-with-strong-key
MEILISEARCH_PORT=7700

# =============================================================================
# 7. 缓存与队列 (Redis + Celery)
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# =============================================================================
# 8. AI 模型与外部服务
# =============================================================================
LOG_LEVEL=INFO

# LLM Provider — 推荐使用云 API
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Embedding (nomic-embed 必需)
EMBEDDING_DIMENSIONS=768
HF_ENDPOINT=https://huggingface.co

# 搜索增强 (可选)
GOOGLE_API_KEY=
BRAVE_API_KEY=

# =============================================================================
# 9. EvoCloud 平台集成
# =============================================================================
EVOCLOUD_API_URL=https://www.evoloop.cn
EVOCLOUD_WS_URL=wss://www.evoloop.cn/gateway/ws
EVOCLOUD_API_KEY=
EVOCLOUD_API_SECRET=
EVOCLOUD_SSL_VERIFY=true

# 服务器不注册为设备（区别于桌面客户端）
# EVOCLOUD_DEVICE_NAME=
# EVOCLOUD_ACCESS_TOKEN=

# =============================================================================
# 10. Agent 与执行引擎
# =============================================================================
EXECUTION_MODE=docker
SANDBOX_IMAGE=evoloop-sandbox

SUPERVISOR_AGENT_MAX_STEPS=30
WORKER_AGENT_MAX_STEPS=100
FINISH_AGENT_MAX_STEPS=10

# 服务器无显示器/浏览器，禁用视觉与宏功能
ENABLE_VISION_OCR=false
ENABLE_MACRO_SELF_HEALING=false
MAX_KEYFRAMES=0

REFLECTIVE_DRIVER_TYPE=active
DEFAULT_SEARCH_TOP_K=10
MAX_SEARCH_DEPTH=3
MIN_RELEVANCE_SCORE=0.6
DEFAULT_CHUNK_SIZE=1000
MAX_CHUNK_SIZE=4000
DEFAULT_CHUNK_OVERLAP=200

MAX_SESSION_HISTORY=20
MEMORY_RELEVANCE_THRESHOLD=0.75
MAX_MEMORY_ITEMS=1000
RECURSION_LIMIT=100
WIKI_EXTRACT_CONCEPTS=true
ENABLE_QUERY_REWRITING=true

# =============================================================================
# 11. 浏览器自动化
# =============================================================================
# 服务器部署不需要浏览器自动化，留空即可
EVOLOOP_CHROME_CDP_URL=
EVOLOOP_CHROME_EXECUTABLE=
EVOLOOP_CHROME_USER_DATA=
EVOLOOP_CHROME_AUTOMATION_USER_DATA=
EVOLOOP_CHROME_PROFILE=
EVOLOOP_CHROME_STARTUP_TIMEOUT=

# =============================================================================
# 12. 邮件与通知
# =============================================================================
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@your-domain.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587

# =============================================================================
# 13. Docker 镜像
# =============================================================================
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# =============================================================================
# 14. 版本信息
# =============================================================================
APP_VERSION=0.1.0
BUILD_NUMBER=1
RELEASE_STAGE=alpha
BUILD_TIME=
GIT_COMMIT=

# =============================================================================
# 15. 移动端同步
# =============================================================================
MOBILE_SYNC_ENABLED=false
