# =============================================================================
# EvoLoop 环境变量配置 — React Native 移动端
# =============================================================================
# 用法:
#   cp config/mobile/.env.example mobile/.env
#   然后: cd mobile && npx react-native start
#
# 移动端是纯客户端，所有业务逻辑通过云端 API。
# ASR 模型通过 mobile/scripts/download-sherpa-asr-model.sh 下载。
# =============================================================================

# 应用名称
APP_NAME=EvoLoop

# =============================================================================
# API / Gateway 配置
# =============================================================================
# 后端 API 基础地址 (HTTP)
EVOCLOUD_BASE_URL=https://evoloop.develop-assistant.cn
# Gateway WebSocket 地址 (WSS)
EVOCLOUD_BASE_WS_URL=wss://evoloop.develop-assistant.cn/gateway/ws
# 微信 Universal Link
EVOCLOUD_UNIVERSAL_LINK_URL=https://evoloop.develop-assistant.cn/universal-link

# =============================================================================
# 阿里云 NLS (实时语音识别)
# =============================================================================
# NLS WebSocket 网关地址
NLS_WS_URL=wss://nls-gateway.aliyuncs.com/ws/v1
# NLS AppKey (从阿里云控制台获取)
# 开通地址: https://www.aliyun.com/product/nls
NLS_APP_KEY=your_nls_app_key_here
# 以下仅用于本地测试，生产环境必须从后端获取 Token
NLS_ACCESS_KEY_ID=your_access_key_id_here
NLS_ACCESS_KEY_SECRET=your_access_key_secret_here

# =============================================================================
# 第三方服务
# =============================================================================
# 微信开放平台 AppID
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here
# 高德地图 Key
AMAP_KEY=your_amap_key_here
