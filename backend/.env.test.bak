# General
PROJECT_NAME=EvoLoop
APP_ENV=testing
PYTHONPATH=.

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

# Redis
REDIS_URL=redis://localhost:6379/1

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888

# Paths
PROJECTS_ROOT=/Users/huangjinhuan/项目/testProjects

# Logging
LOG_LEVEL=DEBUG
DB_ECHO=False

# Embeddings (Local LM Studio)
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768
