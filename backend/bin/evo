#!/usr/bin/env bash
#
# EvoLoop CLI 工具 (ARM64 版本)
# ============================

set -e

# 强制使用 arm64 架构执行
if [ "$(arch)" != "arm64" ]; then
    exec arch -arm64 "$0" "$@"
fi

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# 辅助函数
info() { echo -e "${BLUE}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✅${NC} $1"; }
error() { echo -e "${RED}❌${NC} $1"; }

# 主命令处理
case "${1:-help}" in
    dev)
        info "启动开发服务器 (arm64)..."
        RELOAD=false arch -arm64 .venv/bin/python bin/run.py api
        ;;
    
    worker)
        info "启动 Celery Worker (arm64)..."
        arch -arm64 .venv/bin/python bin/run.py worker
        ;;
    
    install)
        info "安装依赖 (arm64)..."
        arch -arm64 .venv/bin/python -m pip install -r requirements.txt 2>/dev/null || \
            arch -arm64 .venv/bin/python -m pip install \
                fastapi uvicorn pydantic sqlmodel celery redis \
                langchain langchain-core langgraph numpy pandas
        success "安装完成"
        ;;
    
    test)
        info "运行测试 (arm64)..."
        arch -arm64 .venv/bin/python -m pytest tests/ -v
        ;;
    
    shell|bash)
        info "进入 arm64 Python shell..."
        arch -arm64 /bin/bash
        ;;
    
    arch)
        echo "当前架构: $(arch)"
        echo "Python 架构: $(arch -arm64 .venv/bin/python -c 'import platform; print(platform.machine())')"
        ;;
    
    *)
        echo "EvoLoop CLI (ARM64)"
        echo ""
        echo "Usage:"
        echo "  evo dev       启动开发服务器"
        echo "  evo worker    启动 Celery Worker"
        echo "  evo install   安装依赖"
        echo "  evo test      运行测试"
        echo "  evo shell     进入 arm64 shell"
        echo "  evo arch      显示架构信息"
        ;;
esac
