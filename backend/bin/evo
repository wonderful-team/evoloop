#!/usr/bin/env bash
#
# EvoLoop CLI 工具
# ================
# 封装常用开发命令，统一通过 evo 命令访问
#
# 安装:
#   chmod +x evo
#   sudo ln -s $(pwd)/evo /usr/local/bin/evo
#
# 使用:
#   evo help              显示帮助
#   evo dev               启动开发服务器
#   evo test              运行测试
#   evo clean             清理系统
#

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"

# 帮助信息
show_help() {
    cat << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║                    EvoLoop CLI 工具                          ║
╠══════════════════════════════════════════════════════════════╣
║                                                              ║
║  【开发环境】                                                 ║
║    evo install          安装依赖                             ║
║    evo dev              启动开发服务器                        ║
║    evo worker           启动 Celery Worker                   ║
║    evo stop             停止所有服务                         ║
║                                                              ║
║  【代码质量】                                                 ║
║    evo lint             运行代码检查                         ║
║    evo format           格式化代码                           ║
║    evo check            全面代码检查                         ║
║    evo fix              自动修复代码问题                     ║
║                                                              ║
║  【测试】                                                     ║
║    evo test             运行测试套件                         ║
║    evo test-cov         运行测试并生成覆盖率报告              ║
║    evo test-e2e         运行端到端测试                       ║
║    evo test-brain       运行 Brain 模块测试                  ║
║    evo test-atlas       运行 Atlas 模块测试                  ║
║                                                              ║
║  【数据库】                                                   ║
║    evo db init          初始化数据库                         ║
║    evo db migrate       运行数据库迁移                       ║
║    evo db reset         重置数据库                           ║
║    evo db seed          填充测试数据                         ║
║                                                              ║
║  【知识库】                                                   ║
║    evo kb reset         清空并重建知识库索引                 ║
║    evo kb clean         仅清空知识库                         ║
║    evo kb rebuild       仅重建知识库索引                     ║
║    evo kb reindex       重新索引所有项目                     ║
║                                                              ║
║  【系统清理】                                                 ║
║    evo clean            清理运行时缓存                       ║
║    evo clean all        完整系统清理                         ║
║    evo clean dry        预览清理内容                         ║
║    evo clean sc         清理截图和录制                       ║
║                                                              ║
║  【存储管理】                                                 ║
║    evo storage stats    查看存储统计                         ║
║    evo storage clean    清理过期存储文件                     ║
║    evo storage test     测试存储功能                         ║
║                                                              ║
║  【Atlas/Mobile】                                           ║
║    evo atlas test       运行 Atlas 端到端测试                ║
║    evo atlas mobile     运行 Atlas 移动端测试                ║
║    evo atlas clear      清空 Atlas 数据                      ║
║                                                              ║
║  【Brain】                                                   ║
║    evo brain test       运行 Brain 完整测试                  ║
║    evo brain real       运行 Brain 实机测试                  ║
║    evo brain letta      运行 Brain Letta 测试                ║
║                                                              ║
║  【验证】                                                     ║
║    evo verify skill     验证技能执行                         ║
║    evo verify storage   验证存储系统                         ║
║    evo verify vector    验证向量维度                         ║
║    evo verify peekaboo  验证 Peekaboo                        ║
║                                                              ║
║  【演示】                                                     ║
║    evo demo final       最终演示                             ║
║    evo demo phase3      阶段3演示                            ║
║    evo demo mobile      移动端演示                           ║
║                                                              ║
║  【运行（生产模式）】                                         ║
║    evo run api          启动 API 服务器（生产模式）          ║
║    evo run worker       启动 Worker（生产模式）              ║
║                                                              ║
║  【导出】                                                     ║
║    evo export openapi   导出 OpenAPI 文档到前端              ║
║                                                              ║
║  【环境】                                                     ║
║    evo doctor           检测开发环境依赖                     ║
║    evo setup            一键配置开发环境                     ║
║                                                              ║
╚══════════════════════════════════════════════════════════════╝
EOF
}

# 打印带颜色的信息
info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

error() {
    echo -e "${RED}✗${NC} $1"
}

# 检查 uv 是否安装
check_uv() {
    if ! command -v uv &> /dev/null; then
        error "uv 未安装，请先安装 uv"
        exit 1
    fi
}

# 主命令处理
case "${1:-help}" in
    help|-h|--help)
        show_help
        ;;

    # ==================== 开发环境 ====================
    install)
        info "安装依赖..."
        uv sync
        info "创建数据库目录..."
        mkdir -p ~/.evoloop/database
        success "安装完成"
        ;;

    dev)
        info "启动开发服务器..."
        RELOAD=true uv run python bin/run.py api
        ;;

    worker)
        info "启动 Celery Worker..."
        uv run python bin/run.py worker
        ;;

    stop)
        info "停止所有服务..."
        pkill -f "python bin/run.py api" 2>/dev/null || true
        pkill -f "python bin/run.py worker" 2>/dev/null || true
        success "服务已停止"
        ;;

    # ==================== 代码质量 ====================
    lint)
        info "运行代码检查..."
        uv run ruff check app scripts
        ;;

    format)
        info "格式化代码..."
        uv run ruff check app scripts --fix
        uv run ruff format app scripts
        success "格式化完成"
        ;;

    check)
        info "运行全面代码检查..."
        echo "🔍 Running Ruff check..."
        uv run ruff check app
        echo "✨ Running Pyright analysis..."
        uv run pyright app
        success "所有检查通过"
        ;;

    fix)
        info "自动修复代码问题..."
        uv run ruff check app scripts --fix
        success "修复完成"
        ;;

    # ==================== 测试 ====================
    test)
        case "${2:-}" in
            cov)
                info "运行测试并生成覆盖率报告..."
                uv run coverage run -m pytest tests/
                uv run coverage report
                uv run coverage html
                ;;
            e2e)
                info "运行端到端测试..."
                uv run pytest tests/e2e/ -v
                ;;
            brain)
                info "运行 Brain 模块测试..."
                uv run python scripts/test_brain_full.py
                ;;
            atlas)
                info "运行 Atlas 模块测试..."
                uv run python scripts/test_atlas_e2e.py
                ;;
            *)
                info "运行测试套件..."
                uv run pytest tests/ -v
                ;;
        esac
        ;;

    # ==================== 数据库 ====================
    db)
        case "${2:-}" in
            init)
                info "初始化数据库..."
                uv run python scripts/init_test_db.py
                ;;
            migrate)
                info "运行数据库迁移..."
                uv run alembic upgrade head
                ;;
            reset)
                info "重置数据库..."
                uv run python app/backend_pre_start.py
                uv run alembic upgrade head
                uv run python app/initial_data.py
                ;;
            seed)
                info "填充测试数据..."
                uv run python scripts/seed_test_data.py
                ;;
            *)
                error "未知数据库命令: ${2:-}"
                echo "可用命令: init, migrate, reset, seed"
                exit 1
                ;;
        esac
        ;;

    # ==================== 知识库 ====================
    kb)
        case "${2:-}" in
            reset)
                info "清空并重建知识库索引..."
                uv run python scripts/reset_and_rebuild.py
                ;;
            clean)
                info "仅清空知识库..."
                uv run python scripts/reset_and_rebuild.py --clean-only
                ;;
            rebuild)
                info "仅重建知识库索引..."
                uv run python scripts/reset_and_rebuild.py --rebuild-only
                ;;
            reindex)
                info "重新索引所有项目..."
                uv run python scripts/reindex_all.py
                ;;
            *)
                error "未知知识库命令: ${2:-}"
                echo "可用命令: reset, clean, rebuild, reindex"
                exit 1
                ;;
        esac
        ;;

    # ==================== 系统清理 ====================
    clean)
        case "${2:-}" in
            all)
                warning "即将执行完整系统清理（包括数据库和文件）"
                read -p "确定继续? (yes/no): " confirm
                if [ "$confirm" = "yes" ]; then
                    uv run python scripts/cleanup_system.py --all --confirm
                else
                    info "已取消"
                fi
                ;;
            dry)
                info "预览清理内容..."
                uv run python scripts/cleanup_system.py --dry-run --all
                ;;
            sc|screenshots)
                info "清理截图和录制..."
                uv run python scripts/manage_screenshots.py cleanup
                ;;
            runtime|"")
                info "清理运行时缓存..."
                uv run python scripts/cleanup_runtime.py
                ;;
            *)
                error "未知清理命令: ${2:-}"
                echo "可用命令: all, dry, sc, runtime"
                exit 1
                ;;
        esac
        ;;

    # ==================== 存储管理 ====================
    storage)
        case "${2:-}" in
            stats)
                uv run python scripts/manage_screenshots.py stats
                ;;
            clean)
                uv run python scripts/manage_screenshots.py cleanup
                ;;
            test)
                uv run python scripts/manage_screenshots.py test
                ;;
            *)
                error "未知存储命令: ${2:-}"
                echo "可用命令: stats, clean, test"
                exit 1
                ;;
        esac
        ;;

    # ==================== Atlas ====================
    atlas)
        case "${2:-}" in
            test)
                uv run python scripts/test_atlas_e2e.py
                ;;
            mobile)
                uv run python scripts/test_atlas_mobile.py
                ;;
            clear)
                uv run python scripts/clear_atlas.py
                ;;
            *)
                error "未知 Atlas 命令: ${2:-}"
                echo "可用命令: test, mobile, clear"
                exit 1
                ;;
        esac
        ;;

    # ==================== Brain ====================
    brain)
        case "${2:-}" in
            test)
                uv run python scripts/test_brain_full.py
                ;;
            real)
                uv run python scripts/test_brain_real.py
                ;;
            letta)
                uv run python scripts/test_brain_letta.py
                ;;
            *)
                error "未知 Brain 命令: ${2:-}"
                echo "可用命令: test, real, letta"
                exit 1
                ;;
        esac
        ;;

    # ==================== 验证 ====================
    verify)
        case "${2:-}" in
            skill)
                uv run python scripts/verification/verify_skill_execution.py
                ;;
            storage)
                uv run python scripts/verify_storage.py
                ;;
            vector)
                uv run python scripts/verify_vector_opt.py
                ;;
            peekaboo)
                uv run python scripts/verify_peekaboo.py
                ;;
            *)
                error "未知验证命令: ${2:-}"
                echo "可用命令: skill, storage, vector, peekaboo"
                exit 1
                ;;
        esac
        ;;

    # ==================== 演示 ====================
    demo)
        case "${2:-}" in
            final)
                uv run python scripts/demo_final.py
                ;;
            phase3)
                uv run python scripts/demo_phase3.py
                ;;
            mobile)
                uv run python scripts/demo_mobile_reactor.py
                ;;
            *)
                error "未知演示命令: ${2:-}"
                echo "可用命令: final, phase3, mobile"
                exit 1
                ;;
        esac
        ;;

    # ==================== 运行（生产模式）====================
    run)
        case "${2:-}" in
            api)
                info "启动 API 服务器（生产模式）..."
                python3 "$SCRIPT_DIR/run_sidecar.py" api
                ;;
            worker)
                info "启动 Celery Worker（生产模式）..."
                python3 "$SCRIPT_DIR/run_sidecar.py" worker
                ;;
            *)
                error "未知运行命令: ${2:-}"
                echo "可用命令: api, worker"
                exit 1
                ;;
        esac
        ;;

    # ==================== 导出 ====================
    export)
        case "${2:-}" in
            openapi)
                info "导出 OpenAPI 文档..."
                uv run python bin/run.py export-openapi
                ;;
            *)
                error "未知导出命令: ${2:-}"
                echo "可用命令: openapi"
                exit 1
                ;;
        esac
        ;;

    # ==================== 环境检测与配置 ====================
    doctor)
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║           EvoLoop 环境诊断                               ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""

        ALL_GOOD=true

        # 检测操作系统
        info "操作系统: $(uname -s) $(uname -r)"

        # 检测 Python
        if command -v python3 &> /dev/null; then
            PYTHON_VERSION=$(python3 --version 2>&1)
            success "$PYTHON_VERSION"
        else
            error "Python 3 未安装"
            ALL_GOOD=false
        fi

        # 检测 uv
        if command -v uv &> /dev/null; then
            UV_VERSION=$(uv --version 2>&1)
            success "uv: $UV_VERSION"
        else
            error "uv 未安装"
            echo "   安装: curl -LsSf https://astral.sh/uv/install.sh | sh"
            ALL_GOOD=false
        fi

        # 检测 Docker
        if command -v docker &> /dev/null; then
            DOCKER_VERSION=$(docker --version | awk '{print $3}' | tr -d ',')
            success "Docker: $DOCKER_VERSION"
        else
            warning "Docker 未安装 (可选，用于容器化部署)"
        fi

        # 检测 Docker Compose
        if command -v docker-compose &> /dev/null || docker compose version &> /dev/null; then
            success "Docker Compose: 已安装"
        else
            warning "Docker Compose 未安装 (可选)"
        fi

        # 检测 Node.js
        if command -v node &> /dev/null; then
            NODE_VERSION=$(node --version)
            success "Node.js: $NODE_VERSION"
        else
            warning "Node.js 未安装 (前端开发需要)"
        fi

        # 检测数据库目录
        if [ -d "$HOME/.evoloop/database" ]; then
            success "数据库目录: $HOME/.evoloop/database"
        else
            info "数据库目录不存在，将在首次运行时创建"
        fi

        # 检测 .env 文件
        if [ -f ".env" ]; then
            success ".env 配置文件: 存在"
        else
            warning ".env 配置文件不存在"
            echo "   创建: cp .env.example .env"
        fi

        echo ""
        if $ALL_GOOD; then
            success "环境检查通过！可以开始开发了"
        else
            error "环境检查未通过，请安装缺失的依赖"
            exit 1
        fi
        ;;

    setup)
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║           EvoLoop 开发环境配置                           ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""

        # 步骤 1: 检查 uv
        if ! command -v uv &> /dev/null; then
            info "安装 uv..."
            curl -LsSf https://astral.sh/uv/install.sh | sh
            export PATH="$HOME/.cargo/bin:$PATH"
        fi

        # 步骤 2: 安装依赖
        info "安装 Python 依赖..."
        uv sync

        # 步骤 3: 创建数据库目录
        info "创建数据目录..."
        mkdir -p ~/.evoloop/database ~/.evoloop/skills ~/.evoloop/screenshots

        # 步骤 4: 复制 .env
        if [ ! -f ".env" ]; then
            info "创建 .env 配置文件..."
            if [ -f ".env.example" ]; then
                cp .env.example .env
                # 生成随机密钥
                if command -v openssl &> /dev/null; then
                    SECRET_KEY=$(openssl rand -base64 32)
                    sed -i.bak "s/SECRET_KEY=.*/SECRET_KEY=$SECRET_KEY/" .env 2>/dev/null || true
                    rm -f .env.bak
                fi
                success ".env 创建完成"
                warning "请编辑 .env 文件配置数据库连接信息"
            else
                error ".env.example 不存在"
            fi
        else
            success ".env 已存在"
        fi

        # 步骤 5: 初始化数据库（可选）
        echo ""
        read -p "是否初始化数据库? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            info "初始化数据库..."
            uv run python app/backend_pre_start.py 2>/dev/null || true
            uv run alembic upgrade head 2>/dev/null || true
            success "数据库初始化完成"
        fi

        echo ""
        success "开发环境配置完成！"
        echo ""
        echo "常用命令:"
        echo "  evo dev        启动开发服务器"
        echo "  evo worker     启动 Celery Worker"
        echo "  evo doctor     检查环境"
        ;;

    # ==================== 工具 ====================
    debug)
        uv run python scripts/debug_messages.py
        ;;

    analyze)
        uv run python scripts/analyze_loop.py
        ;;

    # ==================== 未知命令 ====================
    *)
        error "未知命令: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
