{% macro render_list(items, title=none, bullet="-") %}
{% if title %}{{ title }}
{% endif %}
{% for item in items %}
{{ bullet }} {{ item }}
{% endfor %}
{% if not items %}
(None found)
{% endif %}
{% endmacro %}

{% macro render_kv_list(data, title=none) %}
{% if title %}{{ title }}
{% endif %}
{% for k, v in data.items() %}
- **{{ k }}**: {{ v }}
{% endfor %}
{% endmacro %}
