{#
  Action Documentation Components
  
  用于渲染 action registry 文档的组件。
#}

{# 单个 action 文档项 #}
{% macro action_doc_item(action) %}
- "{{ action.id }}": {{ action.description }}{% if action.params %} Params: {{ action.params | join(", ") }}{% endif %}
{% endmacro %}

{# 按平台分组的 action 列表 #}
{% macro action_docs_by_platform(actions, platform, title) %}
{% set platform_actions = actions | selectattr("platforms", "contains", platform) | list %}
{% if platform_actions %}
#### {{ title }}:
{% for action in platform_actions %}{{ action_doc_item(action) }}{% endfor %}
{% endif %}
{% endmacro %}

{# 完整的 action 文档（所有平台） #}
{% macro action_docs_full(actions, default_actions="navigate, click, input, scroll, wait, screenshot, get_text, get_attribute, key_press") %}
{% if actions %}
{{ action_docs_by_platform(actions, "dom", "Web/DOM") }}
{{ action_docs_by_platform(actions, "mobile", "Mobile/Android") }}
{{ action_docs_by_platform(actions, "desktop", "Desktop/MacOS") }}
{% else %}
- {{ default_actions }}
{% endif %}
{% endmacro %}
