{# 时间戳格式化显示 #}
{% macro format_timestamp(ts, decimals=2, suffix="s") %}
[{{ ts | round(decimals) }}{{ suffix }}]
{% endmacro %}

{# 位置坐标格式化 #}
{% macro format_position(pos, decimals=3) %}
{% if pos %}({{ pos[0] | round(decimals) }}, {{ pos[1] | round(decimals) }}){% endif %}
{% endmacro %}

Total Events: {{ events | length }}
Screen Resolution: {{ resolution[0] }}x{{ resolution[1] }}

{% for event in events %}
{% if event.action_name != "mouse_move" and event.action_name != "cursor_move" and event.action_name != "touch_up" %}
{{ loop.index }}. {{ format_timestamp(event.timestamp, 2) }} {{ event.action_name }}
{%- if event.norm_pos %} at {{ format_position(event.norm_pos, 3) }} [{{ event.position_desc }}]{% endif %}
{%- if event.target %} on "{{ event.target }}"{% endif %}
{%- if event.app %} in [{{ event.app }}{% if event.window %} - {{ event.window }}{% endif %}]{% endif %}
{%- if event.key %} key='{{ event.key }}'{% endif %}
{% endif %}
{% endfor %}
