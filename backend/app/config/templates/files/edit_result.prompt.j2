{% endfor %}
💡 {{ labels.fix_hint or "Please fix these errors to ensure code quality." }}
{%- elif warnings -%}

ℹ️ {{ labels.type_warnings | format(warnings | length) if labels.type_warnings else "Found " ~ (warnings | length) ~ " type warning(s)." }}
{%- endif -%}
{%- endif -%}

