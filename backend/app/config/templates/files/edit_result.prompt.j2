{% if success -%}
✅ {{ message }}
{% if replaced_count %}   Replaced {{ replaced_count }} occurrence(s){% endif %}
{% if new_hash %}   New hash: {{ new_hash }}{% endif %}
{%- else -%}
❌ {{ message or "Edit failed." }}
{%- endif -%}

{% if diagnostics -%}
{%- set errors = diagnostics | selectattr("severity", "equalto", "Error") | list -%}
