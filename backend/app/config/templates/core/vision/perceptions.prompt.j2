{% macro render_list(items, title=none, bullet="-") %}
{% if title %}{{ title }}
{% endif %}
{% for item in items %}
{{ bullet }} {{ item }}
{% endfor %}
{% if not items %}
(None found)
{% endif %}
{% endmacro %}

{% macro render_kv_list(data, title=none) %}
{% if title %}{{ title }}
{% endif %}
{% for k, v in data.items() %}
- **{{ k }}**: {{ v }}
{% endfor %}
{% endmacro %}


{% if type == "links" %}
### Found {{ items|length }} links
{% for lnk in items[:100] %}
- [{{ loop.index0 }}] {{ lnk['text'][:60] }} → {{ lnk['href'] }}
{% endfor %}
{% if not items %}
(None found)
{% endif %}
{% elif type == "cookies" %}
### Cookies ({{ items|length }})
{% for c in items %}
- [{{ loop.index0 }}] {{ c['name'] }}={{ c['value'][:40] }} (domain: {{ c.get('domain', '') }})
{% endfor %}
{% if not items %}
(None found)
{% endif %}
{% elif type == "devices" %}
### Connected Devices ({{ items|length }})
{{ render_list(items) }}
{% elif type == "extractions" %}
### Extracted Data
{{ render_kv_list(items) }}
{% elif type == "tools_used" %}
### Tools Used ({{ items|length }})
{{ render_list(items) }}
{% elif type == "wiki_pages" %}
### Wiki Pages ({{ items|length }})
{{ render_list(items) }}
{% elif type == "android_devices" %}
### Android Devices ({{ items|length }})
{{ render_list(items) }}
{% elif type == "ui_elements" %}
### UI Elements ({{ items[:max_items] | length }})
{% for el in items[:max_items] %}
- [{{ loop.index0 }}] {{ el.get('role', 'Unknown') }}: {{ el.get('name', 'Unnamed') }}
{% endfor %}
{% if not items %}
(None found)
{% endif %}
{% endif %}