{%- if environment_summaries -%}
- Host: {{ environment_summaries.host.model or 'unknown' }} ({{ environment_summaries.host.cpu or 'unknown' }}), {{ environment_summaries.host.os_name or 'unknown' }} {{ environment_summaries.host.os_version or '' }}{% if environment_summaries.host.current_time %} — Current time: {{ environment_summaries.host.current_time }}{% endif %}
{%- if environment_summaries.host.cpu_percent is not none or environment_summaries.host.memory_percent is not none %}
- Real-time telemetry: CPU {{ environment_summaries.host.cpu_percent or '?' }}%, Memory {{ environment_summaries.host.memory_percent or '?' }}% ({{ environment_summaries.host.memory_available_gb or '?' }} GB available), Disk {{ environment_summaries.host.disk_space.percent_used or '?' }}% used ({{ environment_summaries.host.disk_space.free_gb or '?' }} GB free)
{%- endif %}
{%- if environment_summaries.host.active_window %}
- Active window: {{ environment_summaries.host.active_window }}
{%- endif %}
{%- if environment_summaries.android_devices %}
{%- for dev in environment_summaries.android_devices %}
- Android {{ '✅' if dev.is_reachable else '⚠️' }} `{{ dev.device_id }}`: {{ dev.model or 'unknown' }} (Android {{ dev.os_version or '?' }}), Battery {{ dev.battery_percent or '?' }}%
{%- endfor %}
{%- endif %}
{%- if environment_summaries.network %}
- Network: {{ 'Online' if environment_summaries.network.internet_connected else 'Offline' }}
{%- endif %}
{%- if environment_summaries.host and environment_summaries.host.running_apps %}
- Running apps: {{ environment_summaries.host.running_apps|join(', ') }} ({{ environment_summaries.host.app_count or environment_summaries.host.running_apps|length }} installed)
{%- endif %}
{%- if environment_summaries.running_services %}
- Background tasks: {{ environment_summaries.running_services|length }} active ({{ environment_summaries.running_services[:3]|map(attribute='title')|join(', ') }}{% if environment_summaries.running_services|length > 3 %}, …{% endif %})
{%- endif %}
{%- if environment_summaries.service_labels or environment_summaries.docker_containers %}
- Active services: {{ environment_summaries.service_labels|join(', ') if environment_summaries.service_labels else 'none' }}; Docker: {{ environment_summaries.docker_containers|map(attribute='name')|join(', ') if environment_summaries.docker_containers else 'none' }}
{%- endif %}
{%- endif -%}
