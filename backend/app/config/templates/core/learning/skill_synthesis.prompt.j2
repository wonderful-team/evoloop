    type: string
    description: Description of param1
instructions: |
  # Expert Skill Guide: ...
  ...
macro_script:
  version: "1.0"
  metadata:
    format: evoloop-macro
    step_count: 3
  steps:
    - step_number: 1
      type: action
      event_type: navigate
      source: dom
      description: Navigate to target site
      payload:
        url: "https://example.com"
    
    - step_number: 2
      type: action
      event_type: click
      source: dom
      target_selector: ".submit-btn"
      description: Click submit button
      payload:
        x: 0.5
        y: 0.3
    
    - step_number: 3
      type: extract
      extract_type: get_text
      source: dom
      target_selector: ".result"
      key: result_text
      description: Extract result
```

