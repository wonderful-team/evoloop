# Test Environment Configuration
# This file is used for running tests

# Environment
ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Frontend
FRONTEND_HOST=http://localhost:5173

# Postgres - Test Database (Docker)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin888

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin888

# Redis - Use DB 15 for tests
REDIS_URL=redis://127.0.0.1:6379/15

# LLM Providers - Use local for testing
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL_NAME=local-model

# Disable external services for tests
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BRAVE_API_KEY=

# Execution
EXECUTION_MODE=local

# Security
SECRET_KEY=test_secret_key_for_testing_only

# Project Management
PROJECTS_ROOT=/tmp/test_projects

# Disable Neo4j memory for tests
USE_NEO4J_MEMORY=false

# Testing specific
TESTING=true
